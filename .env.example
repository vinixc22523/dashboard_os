# Supabase (crie um projeto próprio em https://supabase.com, não use o do Lovable)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Pipefy
PIPEFY_PIPE_ID=coloque-o-id-do-pipe-aqui
PIPEFY_API_TOKEN=coloque-o-token-pessoal-do-pipefy-aqui

# Protege a rota /api/sync (botão "Atualizar agora") contra chamadas externas.
# Gere qualquer string aleatória longa, ex: openssl rand -hex 32
SYNC_SECRET=troque-por-uma-string-aleatoria

# Protege a rota /api/cron. A Vercel envia esse valor automaticamente como
# "Authorization: Bearer <CRON_SECRET>" quando o cron dispara.
CRON_SECRET=troque-por-outra-string-aleatoria
